{
  "name": "raisanwall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "check": "astro check",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:lifecycle": "node scripts/lifecycle-test.mjs",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "wrangler d1 migrations apply raisanwall --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "astro": "^7.4.1",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "undici": "^7.30.1"
    }
  }
}
