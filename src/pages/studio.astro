---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { isAuthenticated, loginConfigured } from '../lib/auth';
import { getPosts, getSettings, getStats } from '../lib/db';
import { categories, dateLabel } from '../lib/display';
import '../styles/studio.css';
const env = Astro.locals.env;
const authenticated = await isAuthenticated(Astro.request, env);
const configured = loginConfigured(env);
const rawSection = Astro.url.searchParams.get('section') || '';
const section = ['settings', 'agent'].includes(rawSection) ? rawSection : 'posts';
const rawPage = Number(Astro.url.searchParams.get('page'));
const page = Number.isSafeInteger(rawPage) && rawPage > 0 && rawPage <= 1_000_000 ? rawPage : 1;
const rawStatus = Astro.url.searchParams.get('status') || '';
const status = ['draft', 'published', 'scheduled', 'archived'].includes(rawStatus) ? rawStatus : '';
const q = (Astro.url.searchParams.get('q') || '').replaceAll('\0', '').slice(0, 200);
const [result, settings, stats] = authenticated ? await Promise.all([getPosts(env.DB, { studio: true, page, status, q, limit: 20 }), getSettings(env.DB), getStats(env.DB)]) : [null, null, null];
const pageLink = (n: number) => { const params = new URLSearchParams(Astro.url.searchParams); params.set('page', String(n)); return `/studio?${params}`; };
---
<Layout title="Publishing studio — RaisanWall" studio>
  <main id="main" class:list={['studio-shell', { 'login-shell': !authenticated }]}>
    {!authenticated ? <section class="login-card"><div class="studio-emblem"><Icon name="edit" size={27}/></div><div class="eyebrow">YOUR PRIVATE CORNER</div><h1>Welcome to Studio.</h1><p>The wall is for everyone.<br/>This little space is just for you.</p>{configured ? <form id="login-form"><label for="password">Studio password</label><input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Enter your password"/><p class="form-error" id="login-error" role="alert"></p><button class="button primary" type="submit">Open my studio<Icon name="arrow" size={17}/></button></form> : <div class="setup-notice"><strong>One small setup step.</strong><p>Run <code>npm run setup</code> in the project folder, then restart the server. Your private access details will be in <code>local-access.txt</code>.</p></div>}<a class="back-link" href="/"><Icon name="back" size={14}/>Just browsing? Back to the wall</a></section> : <>
      <header class="studio-header"><div><div class="eyebrow"><span class="status-dot"></span> PRIVATE PUBLISHING SPACE</div><h1>Your wall, your words<span>.</span></h1><p>A good idea deserves somewhere to land.</p></div><div class="studio-header-actions"><a class="button subtle" href="/" target="_blank">View wall<Icon name="external" size={14}/></a><button class="icon-button" id="logout-button" aria-label="Sign out"><Icon name="logout"/></button></div></header>
      <div class="studio-stats"><div><Icon name="grid"/><span><strong>{stats!.posts}</strong>Public posts</span></div><div><Icon name="eye"/><span><strong>{stats!.visits.toLocaleString()}</strong>Page visits</span></div><div><Icon name="calendar"/><span><strong>{dateLabel(stats!.started_at)}</strong>Started sharing</span></div><div><Icon name="clock"/><span><strong>{dateLabel(stats!.last_updated)}</strong>Last update</span></div></div>
      <nav class="studio-tabs" aria-label="Studio sections"><a href="/studio" class:list={{ active: section === 'posts' }}><Icon name="list" size={17}/>Your posts</a><a href="/studio?section=settings" class:list={{ active: section === 'settings' }}><Icon name="settings" size={17}/>Wall settings</a><a href="/studio?section=agent" class:list={{ active: section === 'agent' }}><Icon name="code" size={17}/>Agent connection</a></nav>
      {section === 'posts' && <section class="studio-posts"><div class="studio-posts-toolbar"><form method="get" action="/studio" class="studio-filter"><label for="studio-search" class="sr-only">Search your posts</label><input id="studio-search" type="search" name="q" placeholder="Find a post…" value={q} maxlength="200"/><label for="status-filter" class="sr-only">Post status</label><select id="status-filter" name="status"><option value="">All statuses</option>{['draft', 'published', 'scheduled', 'archived'].map(value => <option value={value} selected={status === value}>{value[0].toUpperCase() + value.slice(1)}</option>)}</select><button class="button subtle" type="submit">Filter</button></form><button class="button primary" id="new-post"><Icon name="plus" size={17}/>New post</button></div>
        <div class="post-table"><div class="post-table-head"><span>POST</span><span>STATUS</span><span>UPDATED</span><span></span></div>{result!.posts.map(post => <div class="post-table-row"><div><button class="post-edit-title" data-edit={post.id}>{post.pinned && <Icon name="pin" size={12}/>}<strong>{post.title}</strong></button><span>{post.category}<span class="signoff-dot">·</span>{post.tags.includes('sample') ? 'Sample post' : post.slug}</span></div><span class={`post-status ${post.status === 'scheduled' && post.published_at && Date.parse(post.published_at) <= Date.now() ? 'published' : post.status}`}>{post.status === 'scheduled' && post.published_at && Date.parse(post.published_at) <= Date.now() ? 'Published' : post.status}</span><time datetime={post.updated_at}>{dateLabel(post.updated_at)}</time><button class="icon-button" data-edit={post.id} aria-label={`Edit ${post.title}`}><Icon name="edit" size={16}/></button></div>)}{result!.posts.length === 0 && <div class="empty-state"><Icon name="edit" size={30}/><h3>{q || status ? 'No posts match this filter.' : 'A blank wall. A fresh start.'}</h3><p>{q || status ? 'Change your filters to find the post you’re looking for.' : 'Start with a thought, a useful link, or your latest discovery.'}</p></div>}</div>
        {result!.pages > 1 && <nav class="pagination" aria-label="Studio pagination">{page > 1 ? <a class="button subtle" href={pageLink(page - 1)}>Previous</a> : <span></span>}<span>{result!.total} posts · Page {page} of {result!.pages}</span>{page < result!.pages ? <a class="button subtle" href={pageLink(page + 1)}>Next</a> : <span></span>}</nav>}
        <p class="studio-helper">Posts tagged <strong>#sample</strong> are demonstration content, not real announcements or offers. Edit or delete them to make this wall yours. Public pages may take up to 30 seconds to refresh.</p>
      </section>}
      {section === 'settings' && <section class="settings-panel"><div><h2>Make yourself at home.</h2><p>A few words to make this wall unmistakably yours.</p></div><form id="settings-form"><div class="form-grid"><label>Wall name<input name="site_name" value={settings!.site_name} maxlength="80" required/></label><label>Your name<input name="author_name" value={settings!.author_name} maxlength="80" required/></label></div><label>Tagline<textarea name="tagline" rows="2" maxlength="200" required>{settings!.tagline}</textarea><small>The short introduction under the headline.</small></label><label>About you<textarea name="author_bio" rows="3" maxlength="1000" required>{settings!.author_bio}</textarea></label><label>Search engine description<textarea name="description" rows="2" maxlength="500" required>{settings!.description}</textarea></label><div class="form-grid"><label>GitHub profile URL<input type="url" name="github_url" value={settings!.github_url} placeholder="https://github.com/your-name"/></label><label>Contact page URL<input type="url" name="contact_url" value={settings!.contact_url} placeholder="Your website or social profile"/></label></div><label>Wall start date<input type="date" name="launch_date" value={settings!.launch_date.slice(0, 10)} required/></label><p class="form-error" id="settings-error" role="alert"></p><button type="submit" class="button primary">Save settings<Icon name="check" size={16}/></button></form></section>}
      {section === 'agent' && <section class="agent-panel"><div class="agent-intro"><span class="studio-emblem"><Icon name="code" size={27}/></span><div><h2>A little help from your agent.</h2><p>Let your AI prepare drafts or publish directly. The public never needs to sign in.</p></div></div><div class="prose"><h3>1. Give your agent a secure connection</h3><p>Use the <code>AGENT_TOKEN</code> from your local access file, or the secret you configured in Cloudflare. Keep it in your agent’s secret store, not in a public prompt or repository. The token grants full publishing and settings access.</p><div class="api-endpoint"><span>BASE URL</span><code>{Astro.url.origin}/api</code><button class="icon-button" data-copy={`${Astro.url.origin}/api`} aria-label="Copy API base URL"><Icon name="copy" size={15}/></button></div><h3>2. Create a draft</h3><p>Send this request with your token as an environment variable. Drafts are private until you publish them.</p><pre><code>{`curl -X POST '${Astro.url.origin}/api/posts' \\\n  -H "Authorization: Bearer $RAISANWALL_TOKEN" \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    "title": "Something worth sharing",\n    "body": "## The idea\\n\\nHere is what I found.",\n    "format": "markdown",\n    "category": "AI & tech",\n    "tags": ["discovery"],\n    "status": "draft"\n  }'`}</code></pre><h3>3. Publish on your terms</h3><p>Change <code>status</code> to <code>published</code> to share immediately, or <code>scheduled</code> with an ISO 8601 <code>published_at</code> timestamp. Scheduled posts appear automatically when their time arrives, with up to 30 seconds of cache delay.</p><table><thead><tr><th>Method</th><th>Endpoint</th><th>Purpose</th></tr></thead><tbody><tr><td>GET</td><td>/posts?view=studio</td><td>List all posts, including drafts</td></tr><tr><td>POST</td><td>/posts</td><td>Create a post</td></tr><tr><td>PATCH</td><td>/posts/:id</td><td>Update or publish; send expected_updated_at from your last read to prevent conflicts</td></tr><tr><td>DELETE</td><td>/posts/:id</td><td>Delete a post permanently</td></tr><tr><td>POST</td><td>/media</td><td>Upload an image using multipart field file</td></tr><tr><td>POST</td><td>/preview</td><td>Render sanitized Markdown or HTML</td></tr><tr><td>GET / PUT</td><td>/settings</td><td>Read or update wall settings</td></tr></tbody></table><h3>What a post can include</h3><p><code>title</code> and <code>body</code> are required. Optional fields: <code>slug</code>, <code>excerpt</code>, <code>category</code>, <code>tags</code> (an array), <code>cover_image</code>, <code>link_url</code>, <code>link_label</code>, <code>invite_code</code>, <code>offer_start</code>, <code>offer_end</code>, <code>pinned</code>, <code>format</code>, <code>status</code>, and <code>published_at</code>. Dates use UTC timestamps. Use categories exactly as shown in Studio.</p><h3>Keep control of your publishing</h3><p>Use drafts for review before an agent publishes. Rotate <code>AGENT_TOKEN</code> to revoke access. Rotate <code>SESSION_SECRET</code> to sign out all Studio sessions. Never put either secret in browser code.</p></div></section>}
      <dialog id="editor-dialog" class="editor-dialog"><form id="post-form"><div class="editor-heading"><div><div class="eyebrow">SOMETHING WORTH SHARING</div><h2 id="editor-title">New post</h2></div><button class="icon-button" type="button" id="close-editor" aria-label="Close editor"><Icon name="close"/></button></div><input type="hidden" name="id"/><input type="hidden" name="updated_at"/>
        <div class="editor-body"><div class="editor-main"><label>Title<input name="title" id="post-title" placeholder="Give your discovery a headline…" required maxlength="200"/></label><div class="form-grid"><label>Post URL slug<input name="slug" placeholder="generated-from-your-title" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" maxlength="120"/><small>Leave empty to generate from the title.</small></label><label>Category<select name="category">{categories.map(item => <option value={item}>{item}</option>)}</select></label></div><label>Short description<textarea name="excerpt" rows="2" maxlength="500" placeholder="A little context for the card on your wall…"></textarea></label><div class="editor-content-toolbar"><label>Write in<select name="format"><option value="markdown">Markdown</option><option value="html">HTML</option></select></label><button class="button subtle" type="button" id="preview-button"><Icon name="eye" size={14}/>Preview</button></div><label><span class="sr-only">Post content</span><textarea name="body" id="post-body" rows="14" required maxlength="100000" placeholder="## Start with an idea&#10;&#10;Write your post. Add **bold thoughts**, [useful links](https://example.com), lists, and images."></textarea></label><div class="prose editor-preview" id="content-preview" hidden></div><p class="field-hint">Headings, paragraphs, lists, code, links, and images are supported. Unsafe HTML is removed.</p><label>Tags<input name="tags" placeholder="ai, productivity, discovery" maxlength="400"/><small>Separate tags with commas. Up to 20 tags.</small></label></div>
        <aside class="editor-options"><h3>The finishing touches</h3><label>Cover image URL<input name="cover_image" placeholder="Upload an image or paste an HTTPS URL" maxlength="2048"/></label><label class="upload-zone"><Icon name="upload" size={22}/><strong>Upload a cover image</strong><span>PNG, JPG, WebP, GIF, AVIF · up to 8 MB</span><input type="file" id="cover-upload" accept="image/png,image/jpeg,image/webp,image/gif,image/avif"/><span id="upload-status" role="status"></span></label><img id="cover-preview" alt="Cover preview" hidden/><div class="editor-divider"></div><label>Destination link<input type="url" name="link_url" placeholder="https://…" maxlength="2048"/></label><label>Link button text<input name="link_label" placeholder="Try the app" maxlength="80"/></label><label>Invite or offer code<input name="invite_code" placeholder="Optional code" maxlength="100"/></label><div class="editor-divider"></div><label>Offer starts (your local time)<input type="datetime-local" name="offer_start"/></label><label>Offer ends (your local time)<input type="datetime-local" name="offer_end"/></label><p class="field-hint">The hourly cleanup archives published offers 72 hours after they end. Post text stays in Studio; uploaded images are permanently deleted unless another post uses them. External images and built-in artwork are kept.</p><div class="editor-divider"></div><label>Publishing<select name="status" id="post-status"><option value="draft">Save as draft</option><option value="published">Publish now</option><option value="scheduled">Schedule for later</option><option value="archived">Keep archived</option></select></label><label id="schedule-label" hidden>Publish at (your local time)<input type="datetime-local" name="published_at"/></label><label class="checkbox-label"><input type="checkbox" name="pinned"/>Pin this post to the top</label></aside></div>
        <footer class="editor-footer"><button class="button danger" type="button" id="delete-post" hidden><Icon name="trash" size={15}/>Delete</button><p class="form-error" id="post-error" role="alert"></p><div><button class="button subtle" type="button" id="cancel-editor">Cancel</button><button type="submit" class="button primary" id="save-post">Save draft<Icon name="check" size={15}/></button></div></footer></form></dialog>
      <dialog class="confirm-dialog" id="discard-dialog"><h2>Discard these changes?</h2><p>Your changes haven’t been saved yet.</p><div><button class="button subtle" id="keep-editing">Keep editing</button><button class="button danger" id="discard-changes">Discard changes</button></div></dialog>
      <dialog class="confirm-dialog" id="delete-dialog"><h2>Delete this post?</h2><p>This permanently removes the post from your wall. This cannot be undone.</p><div><button class="button subtle" id="cancel-delete">Keep post</button><button class="button danger" id="confirm-delete">Delete post</button></div></dialog>
    </>}
  </main>
  <script src="../scripts/studio.ts"></script>
</Layout>
